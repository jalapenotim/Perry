  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
// ANALOG_INPUT 
// BUFFER_INPUT 
// STRING_INPUT
DIGITAL_INPUT 	update;
DIGITAL_OUTPUT 	Sun,Mon,Tue,Wed,Thu,Fri,Sat;
// ANALOG_OUTPUT 
// STRING_OUTPUT 

